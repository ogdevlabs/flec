# Flec environment configuration
# Copy this file to .env and fill in values for your environment
#
# Quick start on any host:
#   cp .env.example .env
#   # fill in HUGGING_FACE_HUB_TOKEN, then:
#   bash scripts/setup.sh

# ---------------------------------------------------------------------------
# HuggingFace — required to download gated datasets (HaGRID fingertip fixtures)
# Obtain a read token at: https://huggingface.co/settings/tokens
# Leave blank to skip HF downloads (scripts fall back to direct/synthetic).
# ---------------------------------------------------------------------------
HUGGING_FACE_HUB_TOKEN=

# Set to 1 to skip BLIP-2 model download and its tests (default on CI).
# BLIP-2 is 4 GB and requires bitsandbytes + a GPU; unset to enable locally.
# FLEC_SKIP_BLIP2=1

# Camera device index (0 = default/first camera, 1 = second camera)
FLEC_CAMERA_INDEX=0

# Enable development mode (uses iPhone Bluetooth camera proxy)
FLEC_DEV_MODE=true

# Logging level: DEBUG | INFO | WARNING | ERROR
FLEC_LOG_LEVEL=INFO

# TTS voice character to use (default = built-in kid-friendly voice)
FLEC_TTS_VOICE=default

# Wake word string (must match the trained model file name in .models/)
FLEC_WAKE_WORD=hey_flec
